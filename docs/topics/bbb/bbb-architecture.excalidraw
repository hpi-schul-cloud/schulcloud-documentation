      "versionNonce": 378771046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781782946860,
      "link": null,
      "locked": false,
      "text": "\n    Start Flow:\n    1. Client: PUT /start -> Server creates VideoConference in DB\n    2. Server: POST /bigbluebutton/api/create -> BBB\n    3. Client: GET /join -> Server builds join URL\n    4. Server returns join URL to client\n    5. Client: window.open(joinUrl) -> Browser to BBB",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "note-flow",
      "originalText": "\n    Start Flow:\n    1. Client: PUT /start -> Server creates VideoConference in DB\n    2. Server: POST /bigbluebutton/api/create -> BBB\n    3. Client: GET /join -> Server builds join URL\n    4. Server returns join URL to client\n    5. Client: window.open(joinUrl) -> Browser to BBB",
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "ac"
    }
