      "updated": 1781782959777,
      "link": null,
      "locked": false,
      "text": "\n        Key implementation details:\n        \n        - meetingID = scopeId + salt\n          (salt regenerated each start)\n        - checksum = SHA-512(\n          callName + params + SALT)\n        - guestPolicy = ASK_MODERATOR\n          when waitingRoom enabled",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "note-meetingid",
      "originalText": "\n        Key implementation details:\n        \n        - meetingID = scopeId + salt\n          (salt regenerated each start)\n        - checksum = SHA-512(\n          callName + params + SALT)\n        - guestPolicy = ASK_MODERATOR\n          when waitingRoom enabled",
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "aY"
    },
